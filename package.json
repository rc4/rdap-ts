{
  "name": "rdap-ts",
  "version": "0.1.2",
  "author": "rc4 <npm@rc4.io>",
  "description": "TypeScript client for the Registration Data Access Protocol (RDAP), the modern-day replacement for WHOIS.",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rc4/rdap-ts.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "rdap",
    "whois",
    "domain",
    "asn"
  ],
  "scripts": {
    "build": "rslib",
    "dev": "rslib --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.eslint.json",
    "test": "rstest run",
    "test:watch": "rstest --watch",
    "test:coverage": "rstest run --coverage",
    "attw": "attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@rslib/core": "^0.23.2",
    "@rstest/adapter-rslib": "^0.11.9",
    "@rstest/core": "^0.11.9",
    "@rstest/coverage-v8": "^0.11.9",
    "@types/http-cache-semantics": "^4.2.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "eslint-plugin-jsdoc": "^64.2.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "http-cache-semantics": "^4.2.0",
    "ipaddr.js": "^2.5.0",
    "valibot": "^1.4.2"
  }
}
